rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==== Email quản trị gốc (sửa cho khớp VITE_SUPER_ADMINS) ====
    function superAdmins() { return ['giangle1502@gmail.com']; }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function staffPath() { return /databases/$(database)/documents/staff/$(me()); }
    function isStaff() {
      return signedIn() && (me() in superAdmins()
        || (exists(staffPath()) && get(staffPath()).data.active != false));
    }
    function isAdmin() {
      return signedIn() && (me() in superAdmins()
        || (exists(staffPath()) && get(staffPath()).data.role == 'admin' && get(staffPath()).data.active != false));
    }
    // Kế toán: chỉ xem & nhập công nợ (không xem hoạt động, báo giá, đơn hàng, khách hàng của sale)
    function isAccountant() {
      return signedIn() && exists(staffPath()) && get(staffPath()).data.role == 'accountant'
        && get(staffPath()).data.active != false;
    }
    function ownsExisting() { return resource.data.ownerEmail == me(); }
    function ownsNew() { return request.resource.data.ownerEmail == me(); }

    // Danh sách nhân viên: ai trong công ty cũng đọc được (để hiện tên), chỉ admin sửa
    match /staff/{email} {
      allow read: if signedIn() && (isStaff() || email == me());
      allow write: if isAdmin();
    }

    // Cài đặt chung
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() || (id == 'receivables' && isAccountant());
    }

    // Dữ liệu của từng nhân viên: sale chỉ thấy/sửa dữ liệu của mình, admin thấy tất cả
    match /{coll}/{id} {
      allow read: if (coll in ['customers', 'activities', 'quotes', 'orders', 'payments', 'purchaseRequests', 'gifts'])
        && isStaff() && (isAdmin() || ownsExisting() || (coll == 'payments' && isAccountant()));
      allow create: if (coll in ['customers', 'activities', 'quotes', 'orders', 'payments', 'purchaseRequests', 'gifts'])
        && isStaff() && (isAdmin() || ownsNew());
      allow update: if (coll in ['customers', 'activities', 'quotes', 'orders', 'payments', 'purchaseRequests', 'gifts'])
        && isStaff() && (isAdmin() || (ownsExisting() && ownsNew()));
      allow delete: if (coll in ['customers', 'activities', 'quotes', 'orders', 'payments', 'purchaseRequests', 'gifts'])
        && isStaff() && (isAdmin() || ownsExisting());
    }

    // Báo cáo ngày: id = <ngày>_<email>
    match /dailyNotes/{noteId} {
      allow read: if isStaff() && (isAdmin() || resource == null || ownsExisting());
      allow create, update: if isStaff() && (isAdmin()
        || (ownsNew() && noteId == request.resource.data.date + '_' + me()));
      allow delete: if isAdmin();
    }

    // Công việc: ownerEmail = người thực hiện
    match /tasks/{id} {
      allow read: if isStaff() && (isAdmin() || ownsExisting());
      allow create: if isStaff() && (isAdmin()
        || (ownsNew() && request.resource.data.createdBy == me()));
      allow update: if isStaff() && (isAdmin()
        || (resource.data.createdBy == me() && ownsExisting() && ownsNew())
        || (ownsExisting() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'progress', 'completedDate', 'comments', 'custom', 'updatedAt', 'updatedBy', 'ownerName'])));
      allow delete: if isStaff() && (isAdmin() || resource.data.createdBy == me());
    }

    // Bộ đếm mã KH tự động: chỉ được tăng
    match /counters/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && (isAdmin() || request.resource.data.n > 0);
      allow update: if isStaff() && (isAdmin() || request.resource.data.n > resource.data.n);
    }

    // Danh mục mặt hàng: mọi nhân viên xem, quản trị sửa
    match /products/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Công nợ nhập từ phần mềm kế toán: sale xem khách của mình; quản trị & kế toán xem tất cả và nhập
    match /receivables/{id} {
      allow read: if isStaff() && (isAdmin() || isAccountant() || ownsExisting());
      allow write: if isAdmin() || isAccountant();
    }

    // Bản chụp công nợ theo ngày (phân tích tuần): chỉ quản trị & kế toán
    match /receivableSnapshots/{id} {
      allow read, write: if isAdmin() || isAccountant();
    }

    // Hàng đã xuất (Ecount, nhập theo ngày/tuần): admin xem & nhập; sale xem dòng của mình
    match /shipments/{id} {
      allow read: if (isStaff() && (isAdmin() || ownsExisting())) || hasPerm('payroll', ['giam_doc']);
      allow write: if isAdmin();
    }

    // Tồn kho & hàng chưa về (Ecount): mọi nhân viên xem, admin nhập
    match /stockSnap/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Đơn chưa giao (Ecount): sale chỉ xem đơn của mình
    match /openOrders/{id} {
      allow read: if isStaff() && (isAdmin() || ownsExisting());
      allow write: if isAdmin();
    }

    // Trò chuyện: nhóm Toàn công ty (type 'all'), nhóm tự tạo, chat riêng 1-1
    function chatMember(d) { return d.type == 'all' || me() in d.members; }
    match /chats/{chatId} {
      allow read: if isStaff() && (isAdmin() || chatMember(resource.data));
      allow create: if isStaff() && request.resource.data.createdBy == me() && (
        (chatId == 'all' && request.resource.data.type == 'all')
        || (request.resource.data.type in ['group', 'dm'] && me() in request.resource.data.members));
      allow update: if isStaff() && (isAdmin() || (chatMember(resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg', 'updatedAt'])
        || (resource.data.type == 'group' && resource.data.createdBy == me() && request.resource.data.createdBy == me())
        || (resource.data.type == 'group' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())))));
      allow delete: if isStaff() && (isAdmin() || resource.data.createdBy == me());
      match /messages/{msgId} {
        allow read: if isStaff() && (isAdmin() || chatMember(get(/databases/$(database)/documents/chats/$(chatId)).data));
        allow create: if isStaff() && request.resource.data.by == me()
          && chatMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow delete: if isStaff() && (isAdmin() || resource.data.by == me()
          || get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == me());
      }
    }
    // Chỉ mục khách hàng toàn công ty (tên, mã, MST, sale) — để cảnh báo trùng khách giữa các sale
    match /customerIndex/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && (isAdmin() || request.resource.data.o == me());
      allow delete: if isStaff() && (isAdmin() || resource.data.o == me());
    }
    match /chatReads/{owner} {
      allow read, write: if signedIn() && owner == me();
    }

    // Báo cáo bán hàng Ecount theo tháng (phân tích): chỉ quản trị
    match /salesMonths/{id} {
      allow read, write: if isAdmin();
    }

    // Nhật ký gửi email: chỉ server ghi (Admin SDK bỏ qua rules), admin xem
    match /reportLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =====================================================================
    // APP NHÂN SỰ – HÀNH CHÍNH (repo hr-app) — dùng chung project này
    // Quyền theo chức năng đọc từ hrSettings/permissions (trang "Phân quyền & luồng duyệt").
    // Giá trị mặc định trong hasPerm(...) phải khớp src/lib/perms.js của app Nhân sự.
    // =====================================================================
    function hrEmpPath() { return /databases/$(database)/documents/hrEmployees/$(me()); }
    function permPath() { return /databases/$(database)/documents/hrSettings/permissions; }
    function isEmp() {
      return signedIn() && (me() in superAdmins()
        || (exists(hrEmpPath()) && get(hrEmpPath()).data.get('status', '') != 'Đã nghỉ việc'));
    }
    function myRoles() { return get(hrEmpPath()).data.get('roles', []); }
    function hasRole(rs) {
      return signedIn() && (me() in superAdmins() || (exists(hrEmpPath()) && myRoles().hasAny(rs)));
    }
    function permRoles(k, d) {
      return exists(permPath()) ? get(permPath()).data.get('map', {}).get(k, d) : d;
    }
    function hasPerm(k, d) {
      return signedIn() && (me() in superAdmins()
        || (exists(hrEmpPath()) && get(hrEmpPath()).data.get('status', '') != 'Đã nghỉ việc'
            && permRoles(k, d).hasAny(myRoles().concat(['*']))));
    }

    // Hồ sơ nhân viên: mọi nhân viên xem danh bạ; người có quyền "Quản lý nhân viên" sửa (chỉ quản trị cấp vai trò Quản trị)
    match /hrEmployees/{email} {
      allow read: if isEmp() || (signedIn() && email == me());
      allow create, update: if hasRole(['admin'])
        || (hasPerm('manageEmployees', ['nhan_su', 'admin']) && !('admin' in request.resource.data.get('roles', []))
            && (resource == null || !('admin' in resource.data.get('roles', []))))
        || (hasPerm('editLeaveBalance', ['nhan_su', 'admin']) && resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaveOpenYear', 'leaveOpenDate', 'leaveOpenLeft', 'leaveAdjust', 'updatedAt', 'updatedBy']));
      allow delete: if hasRole(['admin']);
    }
    match /hrDepartments/{id} {
      allow read: if isEmp();
      allow write: if hasPerm('manageEmployees', ['nhan_su', 'admin']);
    }
    // Cài đặt: 'permissions' (phân quyền, luồng duyệt) và 'fleet' cần quyền Phân quyền
    match /hrSettings/{id} {
      allow read: if isEmp();
      allow write: if (id == 'permissions' || id == 'fleet') ? hasPerm('managePerms', ['admin', 'giam_doc']) : hasPerm('manageSettings', ['nhan_su', 'admin']);
    }
    // Đơn nghỉ phép: chủ đơn + mọi người duyệt của đơn (watchers) + người có quyền xem tất cả
    match /leaveRequests/{id} {
      allow read: if isEmp() && (hasPerm('viewAllLeave', ['nhan_su', 'giam_doc', 'pho_giam_doc', 'admin']) || me() in resource.data.watchers);
      allow create: if isEmp() && ownsNew() && me() in request.resource.data.watchers
        && request.resource.data.status == 'Chờ duyệt';
      allow update: if isEmp() && (hasRole(['admin'])
        || (me() in resource.data.watchers && !ownsExisting())
        || (ownsExisting() && ownsNew() && request.resource.data.status in ['Chờ duyệt', 'Đang duyệt', 'Đã hủy']));
      allow delete: if hasRole(['admin']);
    }
    // Xe
    match /vehicles/{id} {
      allow read: if isEmp();
      allow write: if hasPerm('manageFleet', ['hanh_chinh', 'admin']);
    }
    // Chế độ "ai đặt trước được xe" (Phân quyền & luồng duyệt → Đặt xe)
    function bookingAuto() { return exists(permPath()) && get(permPath()).data.get('bookingMode', 'approval') == 'auto'; }
    // Đặt xe: mọi nhân viên xem (để biết xe trống); người duyệt nằm trong watchers
    match /vehicleBookings/{id} {
      allow read: if isEmp();
      allow create: if isEmp() && ownsNew() && (request.resource.data.status == 'Chờ duyệt'
        || (request.resource.data.status == 'Đã duyệt' && (bookingAuto() || hasPerm('noApprovalBooking', ['giam_doc'])
            || (request.resource.data.forDirector == true && hasPerm('bookForDirector', ['tai_xe', 'hanh_chinh', 'admin'])))));
      allow update: if isEmp() && (hasRole(['admin']) || hasPerm('manageFleet', ['hanh_chinh', 'admin'])
        || (me() in resource.data.get('watchers', []) && !ownsExisting())
        || (ownsExisting() && ownsNew() && (request.resource.data.status != 'Đã duyệt' || resource.data.status == 'Đã duyệt')));
      allow delete: if hasRole(['admin']);
    }
    // Kế hoạch công việc
    match /workTasks/{id} {
      allow read: if isEmp() && (hasPerm('tasksAll', ['giam_doc', 'pho_giam_doc', 'ke_toan_truong', 'admin']) || me() in resource.data.watchers);
      allow create: if isEmp() && request.resource.data.createdBy == me() && me() in request.resource.data.watchers
        && (request.resource.data.ownerEmail == me() || hasPerm('tasksAll', ['giam_doc', 'pho_giam_doc', 'ke_toan_truong', 'admin'])
            || hasPerm('tasksAssignTeam', ['truong_phong']));
      allow update: if isEmp() && (hasPerm('tasksAll', ['giam_doc', 'pho_giam_doc', 'ke_toan_truong', 'admin'])
        || resource.data.createdBy == me()
        || (me() in resource.data.watchers && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['completions', 'status', 'progress', 'completedDate', 'doneNote', 'updatedAt', 'updatedBy'])));
      allow delete: if isEmp() && (hasPerm('tasksAll', ['giam_doc', 'pho_giam_doc', 'ke_toan_truong', 'admin']) || resource.data.createdBy == me());
    }

    // Chấm công: nhân viên tự xác nhận đi làm; cấp trên trực tiếp (managerEmail) xác nhận / chấm thay; tháng khóa sổ thì chỉ người có quyền khóa sổ sửa
    function attOpen(m) {
      return !exists(/databases/$(database)/documents/attendanceLocks/$(m))
        || get(/databases/$(database)/documents/attendanceLocks/$(m)).data.locked != true
        || hasPerm('lockAttendance', ['nhan_su', 'admin']);
    }
    function attAll() { return hasPerm('attendanceAll', ['nhan_su', 'giam_doc', 'pho_giam_doc', 'admin']); }
    match /attendance/{id} {
      allow read: if isEmp() && (attAll() || me() in resource.data.watchers);
      allow create: if isEmp() && attOpen(request.resource.data.month) && (attAll()
        || (ownsNew() && request.resource.data.status == 'Chờ xác nhận' && request.resource.data.mark == '')
        || (!ownsNew() && request.resource.data.managerEmail == me()));
      allow update: if isEmp() && attOpen(resource.data.month) && (attAll()
        || (!ownsExisting() && resource.data.managerEmail == me())
        || (ownsExisting() && resource.data.status == 'Chờ xác nhận' && request.resource.data.status == 'Chờ xác nhận' && request.resource.data.mark == ''));
      allow delete: if hasRole(['admin']) || hasPerm('lockAttendance', ['nhan_su', 'admin']);
    }
    match /attendanceLocks/{m} {
      allow read: if isEmp();
      allow write: if hasPerm('lockAttendance', ['nhan_su', 'admin']);
    }
    // Trường dữ liệu tùy chỉnh
    match /hrFields/{entity} {
      allow read: if isEmp();
      allow write: if hasPerm('manageSettings', ['nhan_su', 'admin']);
    }
    // Danh sách chọn dùng chung: mọi nhân viên được thêm lựa chọn mới (nút ＋)
    match /hrOptions/{key} {
      allow read: if isEmp();
      allow create: if isEmp();
      allow update: if isEmp() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['values', 'updatedAt', 'updatedBy'])
        && request.resource.data.values.hasAll(resource.data.values);
      allow update, delete: if hasPerm('manageSettings', ['nhan_su', 'admin']);
    }
    // Bảng lương: chỉ người có quyền "Bảng lương" (mặc định Giám đốc)
    match /payrollProfiles/{email} { allow read, write: if hasPerm('payroll', ['giam_doc']); }
    match /payrollSettings/{id} { allow read, write: if hasPerm('payroll', ['giam_doc']); }
    match /payrollPeriods/{m} { allow read, write: if hasPerm('payroll', ['giam_doc']); }

    // Nhật ký kiểm toán: chỉ thêm, không sửa/xóa
    match /auditLogs/{id} {
      allow create: if isEmp() && request.resource.data.by == me();
      allow read: if hasRole(['admin', 'giam_doc']);
      allow update, delete: if false;
    }
  }
}
